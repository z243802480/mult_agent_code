{
  "name": "asteria-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server.mjs",
    "start:studio": "powershell -ExecutionPolicy Bypass -File ./start-studio.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smokes": "node scripts/run-smokes.mjs",
    "test:smokes:all": "node scripts/run-smokes.mjs --with-model",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:run-detail": "node scripts/run-detail-smoke.mjs",
    "test:intent-router": "node scripts/intent-router-unit.mjs",
    "test:permission-level": "node scripts/permission-level-unit.mjs",
    "smoke:intent-routing": "node scripts/intent-routing-smoke.mjs",
    "smoke:chat-fallback": "node scripts/chat-fallback-smoke.mjs",
    "smoke:chat-lifecycle": "node scripts/chat-lifecycle-smoke.mjs",
    "smoke:user-thread-copy": "node scripts/user-thread-copy-smoke.mjs",
    "test:session-main-path": "node scripts/session-main-path-contract.mjs",
    "smoke:homepage-copy": "node scripts/homepage-copy-smoke.mjs",
    "test:ui": "npm run build && playwright test",
    "smoke:interactive-main-path": "npm run build && playwright test scripts/interactive-main-path.spec.mjs",
    "smoke:live-main-action": "npm run build && playwright test scripts/live-workspace-main-action.spec.mjs",
    "smoke:plan-output": "node scripts/plan-output-smoke.mjs",
    "smoke:chat-stream-final": "node scripts/chat-stream-final-smoke.mjs",
    "smoke:friendly-ssl-error": "node scripts/friendly-ssl-error-smoke.mjs",
    "smoke:session-lifecycle": "node scripts/session-lifecycle-smoke.mjs",
    "smoke:workspace-files": "node scripts/workspace-files-smoke.mjs",
    "smoke:preview-serve": "node scripts/preview-serve-smoke.mjs",
    "smoke:preview-proxy": "node scripts/preview-proxy-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.7"
  }
}
