{
  "name": "asteria-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server.mjs",
    "start:studio": "powershell -ExecutionPolicy Bypass -File ./start-studio.ps1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:run-detail": "node scripts/run-detail-smoke.mjs",
    "test:intent-router": "node scripts/intent-router-unit.mjs",
    "smoke:intent-routing": "node scripts/intent-routing-smoke.mjs",
    "smoke:chat-fallback": "node scripts/chat-fallback-smoke.mjs",
    "smoke:chat-lifecycle": "node scripts/chat-lifecycle-smoke.mjs",
    "smoke:user-thread-copy": "node scripts/user-thread-copy-smoke.mjs",
    "test:session-main-path": "node scripts/session-main-path-contract.mjs",
    "smoke:homepage-copy": "node scripts/homepage-copy-smoke.mjs",
    "smoke:interactive-main-path": "npm run build && npx -y playwright test scripts/interactive-main-path.spec.mjs",
    "smoke:live-main-action": "npm run build && npx -y playwright test scripts/live-workspace-main-action.spec.mjs",
    "smoke:plan-output": "node scripts/plan-output-smoke.mjs",
    "smoke:chat-stream-final": "node scripts/chat-stream-final-smoke.mjs",
    "smoke:friendly-ssl-error": "node scripts/friendly-ssl-error-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
