{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewArtifacts",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "source",
    "files",
    "omitted_paths",
    "complete",
    "workspace_root",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "current_workspace"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "omitted_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "content",
          "content_sha256",
          "metadata"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "workspace_root": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
