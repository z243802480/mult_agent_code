{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelRouteCheck",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "tier",
    "purpose",
    "provider",
    "model_name",
    "base_url",
    "status",
    "summary",
    "failure_type",
    "deadline_ms",
    "duration_ms",
    "streaming",
    "route_fallback"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "created_at": { "type": "string" },
    "tier": { "type": "string" },
    "purpose": { "type": "string" },
    "provider": { "type": "string" },
    "model_name": { "type": ["string", "null"] },
    "base_url": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["success", "failure"] },
    "summary": { "type": "string" },
    "failure_type": { "type": ["string", "null"] },
    "deadline_ms": { "type": ["integer", "null"] },
    "duration_ms": { "type": ["integer", "null"] },
    "streaming": {
      "type": ["object", "null"],
      "properties": {
        "requested": { "type": "boolean" },
        "supported": { "type": "boolean" },
        "mode": { "type": "string" },
        "first_chunk_ms": { "type": ["integer", "null"] },
        "last_chunk_ms": { "type": ["integer", "null"] },
        "duration_ms": { "type": ["integer", "null"] },
        "chunk_count": { "type": "integer" },
        "idle_timeout_ms": { "type": ["integer", "null"] },
        "deadline_ms": { "type": ["integer", "null"] },
        "finish_reason": { "type": ["string", "null"] },
        "error_type": { "type": ["string", "null"] }
      }
    },
    "route_fallback": { "type": "object" }
  }
}
