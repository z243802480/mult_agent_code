    "run_id",
    "status",
    "review_status",
    "final_report_path",
    "workflow_state",
    "current_blocker",
    "recommended_next_command",
    "model_selection",
    "blockers",
    "next_actions",
    "goal_policy",
    "updated_at"
  ],
