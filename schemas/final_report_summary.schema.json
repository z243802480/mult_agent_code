    "run_id": { "type": "string" },
    "status": { "type": "string" },
    "review_status": { "type": "string" },
    "final_report_path": { "type": "string" },
    "workspace_envelope": { "type": "object" },
    "output_locations": { "type": "object" },
    "workflow_state": { "type": ["string", "null"] },
    "current_blocker": { "type": ["string", "null"] },
    "recommended_next_command": { "type": ["string", "null"] },
    "main_path": { "type": "object" },
