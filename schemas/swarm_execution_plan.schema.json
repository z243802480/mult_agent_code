    "swarm_execution_plan_id": { "type": "string" },
    "subagent_child_plan_id": { "type": "string" },
    "run_id": { "type": "string" },
    "parent_task_id": { "type": "string" },
    "scheduling_mode": { "type": "string" },
    "fake_path": { "type": "boolean" },
    "parallel_writes": { "type": "boolean" },
