{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunLoopSummary",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "iteration_count",
    "stop_reason",
    "latest_evidence",
    "workflow_state",
    "current_blocker",
    "recommended_next_command",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "iteration_count": { "type": "integer", "minimum": 0 },
    "stop_reason": { "type": "string" },
    "latest_evidence": {
      "type": ["object", "null"],
      "required": ["path", "task_id", "status", "summary"],
      "properties": {
        "path": { "type": "string" },
        "task_id": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "evidence_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "workflow_state": { "type": ["string", "null"] },
    "current_blocker": { "type": ["string", "null"] },
    "recommended_next_command": { "type": ["string", "null"] },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
