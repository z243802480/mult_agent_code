{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalQueue",
  "type": "object",
  "required": [
    "schema_version",
    "queue_id",
    "status",
    "items",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "queue_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "archived"]
    },
    "max_items": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "goal_id",
          "goal_text",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "goal_id": { "type": "string" },
          "goal_text": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "done", "skipped"]
          },
          "source": { "type": "string" },
          "linked_run_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
