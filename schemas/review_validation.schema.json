{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewValidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "artifact_evidence_id", "task_id", "is_os_sandbox", "promoted", "stop_reason", "copy_created", "source_manifest", "source_manifest_sha256", "observations", "errors", "limits"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": ["string", "null"]},
    "artifact_evidence_id": {"type": "string"},
    "task_id": {"type": "string"},
    "is_os_sandbox": {"const": false},
    "promoted": {"const": false},
    "stop_reason": {"type": "string"},
    "copy_created": {"type": "boolean"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest": {
      "type": "array", "maxItems": 10000,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}
    },
    "observations": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
        "required": ["tool_call_id", "tool_name", "ok"],
        "properties": {"tool_call_id": {"type": "string"}, "observation_id": {"type": "string"}, "tool_name": {"type": "string"}, "ok": {"type": "boolean"}, "status": {"type": "string"}}}
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "object"}
  }
}
