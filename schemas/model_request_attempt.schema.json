{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelRequestAttempt",
  "type": "object",
  "required": [
    "schema_version",
    "request_attempt_id",
    "purpose",
    "model_provider",
    "model_name",
    "model_tier",
    "created_at",
    "messages_sha256",
    "run_id",
    "task_id",
    "status",
    "scope",
    "dispatch_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "request_attempt_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "model_provider": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "model_tier": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "messages_sha256": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "logical_provider_call"
      ]
    },
    "dispatch_state": {
      "type": "string",
      "enum": [
        "unobserved"
      ]
    },
    "input_evidence": {
      "type": "object",
      "required": [
        "scope",
        "status",
        "messages_sha256",
        "assembly_messages_sha256",
        "observations"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "request_assembly_only"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "messages_changed",
            "invalid"
          ]
        },
        "messages_sha256": {
          "type": "string"
        },
        "assembly_messages_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tool_call_id",
              "tool_name",
              "message_index",
              "feedback_sha256",
              "payload_sha256",
              "receipt_sha256",
              "payload_included",
              "dispatch_state"
            ],
            "properties": {
              "tool_call_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              },
              "message_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "feedback_sha256": {
                "type": "string"
              },
              "payload_sha256": {
                "type": "string"
              },
              "receipt_sha256": {
                "type": "string"
              },
              "payload_included": {
                "type": "boolean"
              },
              "dispatch_state": {
                "type": "string",
                "enum": [
                  "unknown",
                  "dispatched",
                  "not_dispatched"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "matched_feedback_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unmatched_feedback_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unidentified_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "omitted_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
