{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_id",
    "workspace_root",
    "input_roots",
    "output_root",
    "candidate_workspace_policy",
    "read_scope",
    "write_scope",
    "artifact_policy",
    "git_policy",
    "permission_mode",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "workspace_id": { "type": "string" },
    "workspace_root": { "type": "string" },
    "input_roots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_root": { "type": "string" },
    "candidate_workspace_policy": { "type": "string" },
    "read_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "write_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_policy": { "type": "string" },
    "git_policy": { "type": "string" },
    "permission_mode": {
      "type": "string",
      "enum": ["ask_everything", "reviewed_auto", "auto"]
    },
    "created_at": { "type": "string" }
  }
}
