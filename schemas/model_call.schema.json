{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelCall",
  "type": "object",
  "required": [
    "created_at",
    "model_call_id",
    "model_name",
    "model_provider",
    "model_tier",
    "purpose",
    "run_id",
    "schema_version",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Task that spent this call (the child task id for a delegated expert)."
    },
    "subagent_role": {
      "type": [
        "string",
        "null"
      ],
      "description": "Expert role when a delegated sub-agent made this call; null for the lead."
    },
    "worker_invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "model_call_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_role_contract": {
      "type": [
        "object",
        "null"
      ]
    },
    "deadline_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "model_route": {
      "type": [
        "object",
        "null"
      ]
    },
    "route_fallback": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "from_tier": {
          "type": "string"
        },
        "to_tier": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "prompt_envelope_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_envelope_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_envelope_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_envelope_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_manifest_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_mode": {
      "description": "Which context builder produced this call: slim/focused come from context_slimming; chat comes from ChatContextBuilder.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "slim",
        "focused",
        "chat",
        null
      ]
    },
    "fast_path_task_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "doc_update",
        "simple_file",
        "single_file_bugfix",
        "complex_change",
        "high_risk",
        null
      ]
    },
    "input_evidence": {
      "type": "object",
      "required": [
        "scope",
        "status",
        "messages_sha256",
        "assembly_messages_sha256",
        "observations"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "request_assembly_only"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "messages_changed",
            "invalid"
          ]
        },
        "messages_sha256": {
          "type": "string"
        },
        "assembly_messages_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tool_call_id",
              "tool_name",
              "message_index",
              "feedback_sha256",
              "payload_sha256",
              "receipt_sha256",
              "payload_included",
              "dispatch_state"
            ],
            "properties": {
              "tool_call_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              },
              "message_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "feedback_sha256": {
                "type": "string"
              },
              "payload_sha256": {
                "type": "string"
              },
              "receipt_sha256": {
                "type": "string"
              },
              "payload_included": {
                "type": "boolean"
              },
              "dispatch_state": {
                "type": "string",
                "enum": [
                  "unknown",
                  "dispatched",
                  "not_dispatched"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "matched_feedback_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unmatched_feedback_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unidentified_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "omitted_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    },
    "purpose": {
      "type": "string"
    },
    "model_provider": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "model_tier": {
      "type": "string",
      "enum": [
        "cheap",
        "medium",
        "strong"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "streaming": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "supported": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "first_chunk_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "last_chunk_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "chunk_count": {
          "type": "integer"
        },
        "idle_timeout_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "deadline_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "review_artifacts_evidence_id": {
      "type": "string"
    },
    "review_artifacts_evidence_ref": {
      "type": "string"
    }
  }
}
