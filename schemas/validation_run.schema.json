{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationRun",
  "type": "object",
  "required": [
    "budgets",
    "control_surface",
    "created_at",
    "dry_run",
    "evidence",
    "goal",
    "next_actions",
    "preflight",
    "root",
    "route_expectations",
    "run_id",
    "run_result",
    "schema_version",
    "status",
    "summary_path",
    "validation_run_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "validation_run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "blocked",
        "dry_run",
        "running",
        "completed",
        "failed"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "goal": {
      "type": "string"
    },
    "preflight": {
      "type": "object"
    },
    "budgets": {
      "type": "object"
    },
    "route_expectations": {
      "type": "object"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "summary_path": {
      "type": "string"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "control_surface": {
      "type": "object",
      "required": [
        "schema_version",
        "command",
        "audience",
        "stability",
        "stable_fields"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "stability": {
          "type": "string",
          "enum": [
            "additive"
          ]
        },
        "stable_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
