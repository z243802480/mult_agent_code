{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyPlan",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "cycle_id",
    "schedule_type",
    "root",
    "status",
    "created_at",
    "objective",
    "summary",
    "budget",
    "signals",
    "actions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "date": { "type": "string" },
    "cycle_id": { "type": "string" },
    "schedule_type": { "type": "string" },
    "root": { "type": "string" },
    "status": { "type": "string" },
    "created_at": { "type": "string" },
    "objective": { "type": "string" },
    "summary": { "type": "string" },
    "budget": { "type": "object" },
    "signals": { "type": "object" },
    "actions": { "type": "array", "items": { "type": "object" } }
  }
}
