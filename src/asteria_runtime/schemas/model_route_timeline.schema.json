{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelRouteTimeline",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "record_count",
    "timeline",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "record_count": { "type": "integer", "minimum": 0 },
    "timeline": {
      "type": "array",
      "items": { "type": "object" }
    },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
