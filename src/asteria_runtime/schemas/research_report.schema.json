{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchReport",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "query",
    "created_at",
    "sources",
    "claims",
    "expanded_requirements",
    "risks",
    "decision_candidates",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "query": { "type": "string" },
    "research_type": {
      "type": "string",
      "enum": [
        "general",
        "product_research",
        "architecture_research",
        "implementation_research",
        "competitive_research",
        "paper_research",
        "open_source_research",
        "risk_research",
        "design_pattern_research"
      ]
    },
    "created_at": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "source_type", "reference", "summary"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "source_type": { "type": "string", "enum": ["local", "url", "search"] },
          "reference": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source_ids", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "expanded_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "priority", "source_ids"],
        "properties": {
          "description": { "type": "string" },
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "mitigation", "source_ids"],
        "properties": {
          "risk": { "type": "string" },
          "mitigation": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "decision_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "options", "recommended_option_id"],
        "properties": {
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "object" } },
          "recommended_option_id": { "type": "string" }
        }
      }
    },
    "design_brief": {
      "type": "object",
      "properties": {
        "problem": { "type": "string" },
        "observed_patterns": { "type": "array", "items": { "type": "string" } },
        "asteria_adaptation": { "type": "array", "items": { "type": "string" } },
        "do_not_copy": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "pattern_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "asteria_adaptation", "validation"],
        "properties": {
          "name": { "type": "string" },
          "seen_in": { "type": "array", "items": { "type": "string" } },
          "why_it_matters": { "type": "string" },
          "asteria_adaptation": { "type": "string" },
          "validation": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "summary": { "type": "string" }
  }
}
