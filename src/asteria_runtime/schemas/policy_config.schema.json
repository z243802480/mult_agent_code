{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyConfig",
  "type": "object",
  "required": [
    "schema_version",
    "decision_granularity",
    "budgets",
    "context",
    "permissions",
    "protected_paths",
    "hooks",
    "promotion",
    "model_routing",
    "commands"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "decision_granularity": {
      "type": "string",
      "enum": ["autopilot", "balanced", "collaborative", "manual"]
    },
    "active_budget_profile": { "type": "string" },
    "active_access_profile": { "type": ["string", "null"] },
    "budgets": {
      "type": "object",
      "required": [
        "max_model_calls_per_goal",
        "max_tool_calls_per_goal",
        "max_total_minutes_per_goal",
        "max_iterations_per_goal",
        "max_repair_attempts_total",
        "max_repair_attempts_per_task",
        "max_research_calls",
        "max_user_decisions"
      ],
      "properties": {
        "max_model_calls_per_goal": { "type": "integer" },
        "max_tool_calls_per_goal": { "type": "integer" },
        "max_total_minutes_per_goal": { "type": "integer" },
        "max_iterations_per_goal": { "type": "integer" },
        "max_repair_attempts_total": { "type": "integer" },
        "max_repair_attempts_per_task": { "type": "integer" },
        "max_replans_per_task": { "type": "integer" },
        "max_research_calls": { "type": "integer" },
        "max_user_decisions": { "type": "integer" },
        "tool_budget_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "budget_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "max_model_calls_per_goal": { "type": "integer" },
          "max_tool_calls_per_goal": { "type": "integer" },
          "max_total_minutes_per_goal": { "type": "integer" },
          "max_iterations_per_goal": { "type": "integer" },
          "max_repair_attempts_total": { "type": "integer" },
          "max_repair_attempts_per_task": { "type": "integer" },
          "max_replans_per_task": { "type": "integer" },
          "max_research_calls": { "type": "integer" },
          "max_user_decisions": { "type": "integer" }
        }
      }
    },
    "access_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "permissions": { "type": "object" }
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "compaction_threshold",
        "hard_stop_threshold",
        "phase_boundary_compaction",
        "handoff_compaction"
      ],
      "properties": {
        "model_context_window_tokens": { "type": "integer" },
        "model_context_windows": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "compaction_threshold": { "type": "number" },
        "hard_stop_threshold": { "type": "number" },
        "phase_boundary_compaction": { "type": "boolean" },
        "handoff_compaction": { "type": "boolean" }
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "allow_network",
        "allow_shell",
        "allow_destructive_shell",
        "allow_global_package_install",
        "allow_secret_file_read",
        "allow_remote_push",
        "allow_deploy",
        "allow_restore_delete_created_files"
      ],
      "properties": {
        "allow_network": { "type": "boolean" },
        "allow_shell": { "type": "boolean" },
        "allow_destructive_shell": { "type": "boolean" },
        "allow_global_package_install": { "type": "boolean" },
        "allow_secret_file_read": { "type": "boolean" },
        "allow_remote_push": { "type": "boolean" },
        "allow_deploy": { "type": "boolean" },
        "allow_restore_delete_created_files": { "type": "boolean" },
        "sandbox_shell": { "type": "boolean" }
      }
    },
    "protected_paths": { "type": "array", "items": { "type": "string" } },
    "hooks": {
      "type": "object",
      "required": [
        "enabled",
        "plugins_enabled",
        "allowed_hook_names",
        "redacted_data_keys",
        "handler_timeout_ms"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "plugins_enabled": { "type": "boolean" },
        "allowed_hook_names": { "type": "array", "items": { "type": "string" } },
        "redacted_data_keys": { "type": "array", "items": { "type": "string" } },
        "handler_timeout_ms": { "type": "integer" }
      }
    },
    "promotion": {
      "type": "object",
      "required": [
        "manual_approval_default",
        "release_blocking_statuses",
        "max_pending_release_promotions",
        "max_blocked_release_promotions"
      ],
      "properties": {
        "manual_approval_default": { "type": "boolean" },
        "release_blocking_statuses": { "type": "array", "items": { "type": "string" } },
        "max_pending_release_promotions": { "type": "integer" },
        "max_blocked_release_promotions": { "type": "integer" }
      }
    },
    "feature_flags": { "type": "object" },
    "capability_flags": { "type": "object" },
    "agent_loop": { "type": "object" },
    "model_routing": { "type": "object" },
    "provider_route_strategy": { "type": "object" },
    "commands": { "type": "object" }
  }
}
