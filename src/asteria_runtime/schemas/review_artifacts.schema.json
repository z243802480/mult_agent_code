{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewArtifacts",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "source",
    "files",
    "omitted_paths",
    "complete",
    "workspace_root",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "current_workspace"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "omitted_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "content",
          "content_sha256",
          "metadata"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "workspace_root": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "review_basis": {
      "type": "object",
      "required": [
        "original_request",
        "goal_interpretation",
        "project_guidance",
        "workspace_scan_coverage"
      ],
      "properties": {
        "original_request": {
          "type": "object",
          "required": [
            "source",
            "content"
          ],
          "properties": {
            "source": {
              "const": "goal_spec.original_goal"
            },
            "content": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "goal_interpretation": {
          "type": "object",
          "required": [
            "origin_status",
            "producer_record",
            "source_labels_are_model_claims",
            "semantics_verified_by_runtime"
          ],
          "properties": {
            "origin_status": {
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "producer_record": {
              "type": [
                "object",
                "null"
              ]
            },
            "source_labels_are_model_claims": {
              "const": true
            },
            "semantics_verified_by_runtime": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "project_guidance": {
          "type": "object",
          "required": [
            "path",
            "content",
            "status",
            "content_sha256",
            "temporal_scope"
          ],
          "properties": {
            "path": {
              "const": "AGENTS.md"
            },
            "content": {
              "type": "string"
            },
            "status": {
              "enum": [
                "absent",
                "partial",
                "complete"
              ]
            },
            "content_sha256": {
              "type": "string"
            },
            "temporal_scope": {
              "const": "current_workspace_at_review"
            }
          },
          "additionalProperties": false
        },
        "workspace_scan_coverage": {
          "type": "object",
          "required": [
            "mechanism",
            "max_scan_files",
            "excluded_directories",
            "excluded_suffixes",
            "exclusions_grant_permission",
            "limitations"
          ],
          "properties": {
            "mechanism": {
              "const": "stat_only"
            },
            "max_scan_files": {
              "type": "integer"
            },
            "excluded_directories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded_suffixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions_grant_permission": {
              "const": false
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "observed_outside_current_edit_boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_budget": {
          "type": "object",
          "required": [
            "source",
            "scope",
            "configured_limits",
            "pressure",
            "interpretation",
            "recorded_outer_iterations",
            "temporal_scope"
          ],
          "properties": {
            "source": {
              "enum": [
                "budget_controller",
                "current_effective_policy"
              ]
            },
            "scope": {
              "const": "shared_goal"
            },
            "configured_limits": {
              "type": "object"
            },
            "pressure": {
              "type": "object"
            },
            "interpretation": {
              "type": "string"
            },
            "recorded_outer_iterations": {
              "type": [
                "integer",
                "null"
              ]
            },
            "temporal_scope": {
              "const": "current_review_start"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review_focus": {
      "type": "object",
      "required": [
        "changes",
        "criteria",
        "task_evidence",
        "omitted_criteria",
        "omitted_write_observations",
        "semantic_coverage",
        "original_request_ref",
        "baseline_scope",
        "omitted_tasks"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "current_content_sha256",
              "status",
              "baseline",
              "diff",
              "omitted_diff_bytes",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "current_content_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "unavailable",
                  "complete",
                  "partial"
                ]
              },
              "baseline": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "source",
                  "backup_id",
                  "manifest_ref",
                  "task_id",
                  "tool_call_id",
                  "observation_id",
                  "existed",
                  "content_sha256"
                ],
                "properties": {
                  "source": {
                    "enum": [
                      "recorded_pre_tool_backup"
                    ]
                  },
                  "backup_id": {
                    "type": "string"
                  },
                  "manifest_ref": {
                    "type": "string"
                  },
                  "task_id": {
                    "type": "string"
                  },
                  "tool_call_id": {
                    "type": "string"
                  },
                  "observation_id": {
                    "type": "string"
                  },
                  "existed": {
                    "type": "boolean"
                  },
                  "content_sha256": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "diff": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "omitted_diff_bytes": {
                "type": "integer"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source_ref",
              "source_kind",
              "task_id",
              "truncated"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "source_kind": {
                "enum": [
                  "user_request",
                  "current_project_guidance",
                  "model_proposal",
                  "task_contract"
                ]
              },
              "task_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "task_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "observation_ids",
              "omitted_observations",
              "relation"
            ],
            "properties": {
              "task_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observation_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "omitted_observations": {
                "type": "integer"
              },
              "relation": {
                "enum": [
                  "same_task_only_not_criterion_coverage"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "omitted_criteria": {
          "type": "integer"
        },
        "omitted_write_observations": {
          "type": "integer"
        },
        "semantic_coverage": {
          "enum": [
            "unassessed"
          ]
        },
        "original_request_ref": {
          "enum": [
            "review_basis.original_request"
          ]
        },
        "baseline_scope": {
          "type": "string"
        },
        "omitted_tasks": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
