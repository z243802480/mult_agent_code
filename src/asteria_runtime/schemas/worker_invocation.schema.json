{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerInvocation",
  "type": "object",
  "required": [
    "schema_version",
    "worker_invocation_id",
    "run_id",
    "task_id",
    "agent_id",
    "runtime_profile_id",
    "status",
    "started_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "worker_invocation_id": { "type": "string" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "runtime_profile_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "denied", "timeout", "cancelled"]
    },
    "started_at": { "type": "string" },
    "ended_at": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "delegation_brief": {
      "type": "object",
      "properties": {
        "goal": { "type": "string" },
        "why": { "type": "string" },
        "known_context": { "type": "object" },
        "files_or_commands": { "type": "object" },
        "constraints": { "type": "object" },
        "allowed_writes": { "type": "array", "items": { "type": "string" } },
        "expected_output": { "type": "array", "items": { "type": "string" } },
        "verification_expectation": { "type": "object" }
      }
    },
    "brief_quality": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "required_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "parent_worker_invocation_id": { "type": "string" },
    "parent_task_id": { "type": "string" },
    "worker_kind": { "type": "string" },
    "parallel_safety": { "type": "string" }
  }
}
