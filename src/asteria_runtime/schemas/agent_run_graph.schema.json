{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRunGraph",
  "type": "object",
  "required": [
    "schema_version",
    "agent_run_graph_id",
    "run_id",
    "status",
    "coordination_modes",
    "max_concurrency_observed",
    "child_worker_plans",
    "collaboration_summary",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "agent_run_graph_id": { "type": "string" },
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["empty", "running", "succeeded", "blocked", "partial"]
    },
    "coordination_modes": { "type": "array", "items": { "type": "string" } },
    "max_concurrency_observed": { "type": "integer" },
    "child_worker_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "child_worker_plan_id",
          "worker_invocation_id",
          "parent_worker_invocation_id",
          "task_id",
          "agent_id",
          "status",
          "runtime_profile_id",
          "context_mount_id",
          "model_profile_id",
          "tool_permission_profile_id",
          "model_tier",
          "budget",
          "read_scope",
          "write_scope",
          "depends_on",
          "coordination_mode",
          "collaboration_role",
          "summary"
        ],
        "properties": {
          "child_worker_plan_id": { "type": "string" },
          "worker_invocation_id": { "type": "string" },
          "worker_result_id": { "type": ["string", "null"] },
          "parent_worker_invocation_id": { "type": ["string", "null"] },
          "subagent_child_plan_id": { "type": "string" },
          "decomposition_strategy": { "type": "string" },
          "scheduling_strategy": { "type": "string" },
          "planned_child_count": { "type": "integer" },
          "planned_child_tasks": { "type": "array", "items": { "type": "object" } },
          "task_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "status": { "type": "string" },
          "result_status": { "type": ["string", "null"] },
          "runtime_profile_id": { "type": "string" },
          "candidate_workspace_id": { "type": "string" },
          "context_mount_id": { "type": "string" },
          "model_profile_id": { "type": "string" },
          "tool_permission_profile_id": { "type": "string" },
          "model_tier": { "type": "string" },
          "budget": {
            "type": "object",
            "required": ["max_model_calls", "max_tool_calls"],
            "properties": {
              "max_model_calls": { "type": "integer" },
              "max_tool_calls": { "type": "integer" },
              "max_runtime_minutes": { "type": "integer" }
            }
          },
          "strategy_mode": { "type": "string" },
          "strategy_max_child_workers": { "type": "integer" },
          "read_scope": { "type": "array", "items": { "type": "string" } },
          "write_scope": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "coordination_mode": { "type": "string" },
          "collaboration_role": { "type": "string" },
          "artifact_refs": { "type": "array", "items": { "type": "string" } },
          "validation_refs": { "type": "array", "items": { "type": "string" } },
          "failure_evidence_refs": { "type": "array", "items": { "type": "string" } },
          "cost": {
            "type": "object",
            "required": ["model_calls", "tool_calls"],
            "properties": {
              "model_calls": { "type": "integer" },
              "tool_calls": { "type": "integer" }
            }
          },
          "summary": { "type": "string" }
        }
      }
    },
    "candidate_workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "task_id",
          "workspace",
          "strategy",
          "workspace_policy",
          "status"
        ],
        "properties": {
          "candidate_id": { "type": "string" },
          "task_id": { "type": "string" },
          "workspace": { "type": "string" },
          "strategy": { "type": "string" },
          "workspace_policy": { "type": "string" },
          "backend_reason": { "type": "string" },
          "branch_name": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "parent_worker_invocation_id": { "type": ["string", "null"] },
          "parent_runtime_profile_id": { "type": ["string", "null"] },
          "worker_kind": { "type": ["string", "null"] },
          "parallel_safety": { "type": ["string", "null"] },
          "promotion_ids": { "type": "array", "items": { "type": "string" } },
          "latest_promotion_status": { "type": "string" },
          "promotable_files": { "type": "array", "items": { "type": "string" } },
          "promoted_files": { "type": "array", "items": { "type": "string" } },
          "manifest_ref": { "type": "string" }
        }
      }
    },
    "promotion_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "promotion_id",
          "task_id",
          "candidate_id",
          "status",
          "approval_mode",
          "promotable_files",
          "promoted_files",
          "updated_at"
        ],
        "properties": {
          "promotion_id": { "type": "string" },
          "task_id": { "type": "string" },
          "candidate_id": { "type": "string" },
          "status": { "type": "string" },
          "approval_mode": { "type": "string" },
          "promotable_files": { "type": "array", "items": { "type": "string" } },
          "promoted_files": { "type": "array", "items": { "type": "string" } },
          "merge_gate_ok": { "type": ["boolean", "null"] },
          "merge_gate_violations": { "type": "array", "items": { "type": "string" } },
          "failure_type": { "type": "string" },
          "failure_message": { "type": "string" },
          "recovery_action": { "type": "string" },
          "recovery_status": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "merge_gate_summary": {
      "type": "object",
      "required": ["total", "passed_count", "blocked_count", "blocked_refs", "violations"],
      "properties": {
        "total": { "type": "integer" },
        "passed_count": { "type": "integer" },
        "blocked_count": { "type": "integer" },
        "blocked_refs": { "type": "array", "items": { "type": "string" } },
        "violations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "promotion_recovery_summary": {
      "type": "object",
      "required": [
        "total",
        "recovered_count",
        "unresolved_count",
        "discarded_candidate_count",
        "recovery_actions",
        "unresolved_refs",
        "recovered_refs",
        "next_actions"
      ],
      "properties": {
        "total": { "type": "integer" },
        "recovered_count": { "type": "integer" },
        "unresolved_count": { "type": "integer" },
        "discarded_candidate_count": { "type": "integer" },
        "recovery_actions": { "type": "array", "items": { "type": "string" } },
        "unresolved_refs": { "type": "array", "items": { "type": "string" } },
        "recovered_refs": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "collaboration_summary": {
      "type": "object",
      "required": [
        "total_workers",
        "successful_workers",
        "failed_workers",
        "blocked_workers",
        "total_model_calls",
        "total_tool_calls",
        "artifact_refs",
        "validation_refs",
        "failure_evidence_refs",
        "merge_strategy",
        "collaboration_protocol",
        "strategy_modes",
        "next_actions"
      ],
      "properties": {
        "total_workers": { "type": "integer" },
        "successful_workers": { "type": "integer" },
        "failed_workers": { "type": "integer" },
        "blocked_workers": { "type": "integer" },
        "total_model_calls": { "type": "integer" },
        "total_tool_calls": { "type": "integer" },
        "artifact_refs": { "type": "array", "items": { "type": "string" } },
        "validation_refs": { "type": "array", "items": { "type": "string" } },
        "failure_evidence_refs": { "type": "array", "items": { "type": "string" } },
        "candidate_workspace_count": { "type": "integer" },
        "promotion_queue_total": { "type": "integer" },
        "promotion_pending_count": { "type": "integer" },
        "promotion_blocked_count": { "type": "integer" },
        "merge_gate_block_count": { "type": "integer" },
        "promotion_recovered_count": { "type": "integer" },
        "promotion_recovery_unresolved_count": { "type": "integer" },
        "merge_strategy": { "type": "string" },
        "collaboration_protocol": {
          "type": "object",
          "required": [
            "isolation_model",
            "review_agent_role",
            "debug_agent_role",
            "merge_gate_role",
            "promotion_queue_role"
          ],
          "properties": {
            "isolation_model": { "type": "string" },
            "review_agent_role": { "type": "string" },
            "debug_agent_role": { "type": "string" },
            "merge_gate_role": { "type": "string" },
            "promotion_queue_role": { "type": "string" }
          }
        },
        "strategy_modes": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "updated_at": { "type": "string" }
  }
}
