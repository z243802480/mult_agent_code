{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklyReport",
  "type": "object",
  "required": [
    "schema_version",
    "week_id",
    "root",
    "created_at",
    "status",
    "summary",
    "long_run",
    "acceptance",
    "model_profile",
    "risks",
    "next_actions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "week_id": { "type": "string" },
    "root": { "type": "string" },
    "created_at": { "type": "string" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "long_run": { "type": "object" },
    "acceptance": { "type": "object" },
    "model_profile": { "type": "object" },
    "usage_signals": { "type": "object" },
    "usage_signal_analysis": { "type": "object" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  }
}
