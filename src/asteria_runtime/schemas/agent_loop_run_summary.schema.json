{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentLoopRunSummary",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "created_at",
    "status",
    "exit_reason",
    "rounds_completed",
    "max_rounds",
    "summary",
    "recommended_command",
    "latest_decision_id",
    "latest_execution_id",
    "latest_observation_id",
    "latest_action",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "task_id": { "type": "string" },
    "created_at": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "waiting_user", "stopped"]
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "completed",
        "tool_failed",
        "max_rounds",
        "budget_hard_stop",
        "ask",
        "stop",
        "subagent_pending",
        "repair_dispatch",
        "replan_dispatch",
        "no_action"
      ]
    },
    "rounds_completed": { "type": "integer" },
    "max_rounds": { "type": "integer" },
    "summary": { "type": "string" },
    "recommended_command": { "type": ["string", "null"] },
    "latest_decision_id": { "type": ["string", "null"] },
    "latest_execution_id": { "type": ["string", "null"] },
    "latest_observation_id": { "type": ["string", "null"] },
    "latest_action": { "type": ["string", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}
