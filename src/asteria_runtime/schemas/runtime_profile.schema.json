{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeProfile",
  "type": "object",
  "required": [
    "agent_id",
    "budget",
    "context_mount_id",
    "model_profile_id",
    "runtime_profile_id",
    "sandbox_profile_id",
    "schema_version",
    "tool_permission_profile_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "runtime_profile_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "model_profile_id": {
      "type": "string"
    },
    "tool_permission_profile_id": {
      "type": "string"
    },
    "account_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sandbox_profile_id": {
      "type": "string"
    },
    "context_mount_id": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "required": [
        "max_model_calls",
        "max_tool_calls"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer"
        },
        "max_tool_calls": {
          "type": "integer"
        },
        "max_runtime_minutes": {
          "type": "integer"
        }
      }
    },
    "parent_runtime_profile_id": {
      "type": "string"
    },
    "worker_kind": {
      "type": "string"
    },
    "parallel_safety": {
      "type": "string"
    },
    "candidate_workspace_id": {
      "type": "string"
    }
  }
}
