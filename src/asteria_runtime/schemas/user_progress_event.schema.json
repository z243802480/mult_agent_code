{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserProgressEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "created_at",
    "channel",
    "event_type",
    "phase",
    "status",
    "title",
    "summary",
    "display_level"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "event_id": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "sequence": { "type": "integer" },
    "channel": {
      "type": "string",
      "enum": ["conclusion", "progress", "workspace", "permission", "model", "tool", "file", "validation", "evidence", "call_chain", "execution_chain", "diagnostic"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "message",
        "delta",
        "start",
        "end",
        "error",
        "turn_start",
        "turn_end",
        "tool_call",
        "tool_output",
        "tool_observation",
        "file_created",
        "file_modified",
        "file_deleted",
        "file_changed",
        "evidence",
        "decision",
        "model_decision",
        "validation_result",
        "final_report",
        "workspace_selected",
        "permission_request",
        "permission_decision",
        "heartbeat"
      ]
    },
    "parent_event_id": { "type": ["string", "null"] },
    "tool_call_id": { "type": ["string", "null"] },
    "phase": {
      "type": "string",
      "enum": ["understand", "plan", "execute", "review", "result", "next", "blocked"]
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "waiting_user", "completed", "failed", "blocked"]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "content_delta": { "type": "string" },
    "display_level": {
      "type": "string",
      "enum": ["main", "inspector"]
    },
    "transcript_kind": {
      "type": "string",
      "enum": [
        "user_message",
        "assistant_message",
        "plan",
        "todo_update",
        "tool_use",
        "tool_result",
        "file_change",
        "verification",
        "permission_request",
        "decision_request",
        "repair",
        "ask",
        "stop",
        "final",
        "context_status",
        "subagent_summary",
        "progress",
        "diagnostic"
      ]
    },
    "ui_intent": {
      "type": "string",
      "enum": ["inform", "work_progress", "needs_input", "needs_attention", "result"]
    },
    "actions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "model_provider": { "type": ["string", "null"] },
    "model_name": { "type": ["string", "null"] },
    "command": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "telemetry": { "type": "object" },
    "call_chain": {
      "type": "array",
      "items": { "type": "string" }
    },
    "execution_chain": {
      "type": "array",
      "items": { "type": "string" }
    },
    "file_changes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "data": { "type": "object" }
  }
}
