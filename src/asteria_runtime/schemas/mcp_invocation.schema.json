    "mcp_invocation_id": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "task_id": { "type": "string" },
    "server_name": { "type": "string" },
    "tool_name": { "type": "string" },
    "server": { "type": "string" },
    "tool": { "type": "string" },
    "arguments": { "type": "object" },
    "capability_decision": { "type": ["object", "string"] },
    "status": { "type": "string" },
    "error_class": { "type": ["string", "null"] },
    "ok": { "type": "boolean" },
    "summary": { "type": "string" },
    "error": { "type": ["string", "null"] },
    "data": { "type": "object" },
