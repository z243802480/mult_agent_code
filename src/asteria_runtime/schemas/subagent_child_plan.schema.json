{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubagentChildPlan",
  "type": "object",
  "required": [
    "schema_version",
    "subagent_child_plan_id",
    "run_id",
    "parent_task_id",
    "target_task_id",
    "parent_decision_id",
    "parent_execution_id",
    "worker_invocation_id",
    "worker_result_id",
    "runtime_profile_id",
    "planner_id",
    "decomposition_strategy",
    "scheduling_strategy",
    "max_child_workers",
    "coordination_policy",
    "status",
    "parallel_safety",
    "child_tasks",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "subagent_child_plan_id": { "type": "string" },
    "run_id": { "type": "string" },
    "parent_task_id": { "type": "string" },
    "target_task_id": { "type": "string" },
    "parent_decision_id": { "type": "string" },
    "parent_execution_id": { "type": "string" },
    "worker_invocation_id": { "type": "string" },
    "worker_result_id": { "type": "string" },
    "runtime_profile_id": { "type": "string" },
    "planner_id": { "type": "string" },
    "decomposition_strategy": { "type": "string" },
    "scheduling_strategy": { "type": "string" },
    "max_child_workers": { "type": "integer" },
    "coordination_policy": { "type": "object" },
    "status": { "type": "string", "enum": ["planned", "running", "succeeded", "failed"] },
    "parallel_safety": { "type": "string" },
    "child_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "child_task_id",
          "task_id",
          "title",
          "objective",
          "acceptance",
          "read_scope",
          "write_scope",
          "allowed_tools",
          "depends_on",
          "risk",
          "parallel_safety",
          "worker_role",
          "write_allowed",
          "expected_output",
          "verification_expectation"
        ],
        "properties": {
          "child_task_id": { "type": "string" },
          "task_id": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "read_scope": { "type": "array", "items": { "type": "string" } },
          "write_scope": { "type": "array", "items": { "type": "string" } },
          "allowed_tools": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string" },
          "parallel_safety": { "type": "string" },
          "worker_role": { "type": "string" },
          "write_allowed": { "type": "boolean" },
          "expected_output": { "type": "array", "items": { "type": "string" } },
          "verification_expectation": { "type": "object" }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" }
  }
}
