{
  "schema_version": "0.1.0",
  "decision_granularity": "balanced",
  "active_budget_profile": "autonomous_long_task",
  "budgets": {
    "max_model_calls_per_goal": 200,
    "max_tool_calls_per_goal": 1000,
    "max_total_minutes_per_goal": 240,
    "max_iterations_per_goal": 32,
    "max_repair_attempts_total": 20,
    "max_repair_attempts_per_task": 4,
    "max_replans_per_task": 2,
    "max_research_calls": 20,
    "max_user_decisions": 12,
    "tool_budget_weights": {
      "read_only": 0,
      "state": 1,
      "verification": 1,
      "write": 2,
      "shell": 2,
      "external": 3,
      "unknown": 1
    }
  },
  "budget_profiles": {
    "validation": {
      "max_model_calls_per_goal": 60,
      "max_tool_calls_per_goal": 120,
      "max_total_minutes_per_goal": 30,
      "max_iterations_per_goal": 8,
      "max_repair_attempts_total": 5,
      "max_repair_attempts_per_task": 2,
      "max_replans_per_task": 2,
      "max_research_calls": 5,
      "max_user_decisions": 5
    },
    "balanced": {
      "max_model_calls_per_goal": 120,
      "max_tool_calls_per_goal": 500,
      "max_total_minutes_per_goal": 120,
      "max_iterations_per_goal": 16,
      "max_repair_attempts_total": 10,
      "max_repair_attempts_per_task": 3,
      "max_replans_per_task": 2,
      "max_research_calls": 10,
      "max_user_decisions": 8
    },
    "autonomous_long_task": {
      "max_model_calls_per_goal": 200,
      "max_tool_calls_per_goal": 1000,
      "max_total_minutes_per_goal": 240,
      "max_iterations_per_goal": 32,
      "max_repair_attempts_total": 20,
      "max_repair_attempts_per_task": 4,
      "max_replans_per_task": 3,
      "max_research_calls": 20,
      "max_user_decisions": 12
    }
  },
  "context": {
    "model_context_window_tokens": 200000,
    "compaction_threshold": 0.75,
    "hard_stop_threshold": 0.9,
    "phase_boundary_compaction": true,
    "handoff_compaction": true
  },
  "permissions": {
    "allow_network": false,
    "allow_shell": true,
    "allow_destructive_shell": false,
    "allow_global_package_install": false,
    "allow_secret_file_read": false,
    "allow_remote_push": false,
    "allow_deploy": false,
    "allow_restore_delete_created_files": true
  },
  "protected_paths": [
    ".env",
    ".env.*",
    "secrets/",
    ".git/",
    "*.pem",
    "*.key",
    "id_rsa",
    "id_ed25519"
  ],
  "hooks": {
    "enabled": true,
    "plugins_enabled": false,
    "allowed_hook_names": [
      "before_worker",
      "after_worker",
      "worker_error",
      "before_tool_call",
      "after_tool_call",
      "tool_call_error"
    ],
    "redacted_data_keys": [
      "secret",
      "token",
      "api_key",
      "apikey",
      "authorization",
      "password",
      "credential",
      "raw_context"
    ],
    "handler_timeout_ms": 1000
  },
  "promotion": {
    "manual_approval_default": false,
    "release_blocking_statuses": [
      "queued",
      "pending_manual_approval",
      "approved",
      "blocked",
      "promotion_failed"
    ],
    "max_pending_release_promotions": 0,
    "max_blocked_release_promotions": 0
  },
  "feature_flags": {
    "streaming": {
      "enabled": true,
      "description": "Enable provider streaming requests and first-token telemetry.",
      "requires": [
        "provider_streaming"
      ]
    },
    "real_disjoint_write_workers": {
      "enabled": false,
      "description": "Enable true parallel disjoint write workers after validation probes prove the gate can block unsafe fanout.",
      "requires": [
        "real_model"
      ]
    }
  },
  "capability_flags": {},
  "mcp": {
    "session_call_timeout_seconds": 60,
    "retry_attempts": 1,
    "servers": []
  },
  "agent_loop": {
    "worker_transport": "json",
    "task_plan_quality_gate_blocks": false,
    "schema_shape_errors_are_repairable": true,
    "inject_capability_manifest": true,
    "loop_quality_guard": {
      "enabled": true,
      "mode": "observe_then_warn",
      "repeated_identical_tool_window": 8,
      "repeated_failed_verification_window": 3,
      "hard_block_only_for_permission_or_destructive_risk": true
    },
    "spawn_parallel_workers_catalog_gray": false,
    "orchestration_workflows_gray": false,
    "isolated_parallel_write_production_path": false,
    "orchestration_dynamic_workflows_gray": false,
    "orchestration_dynamic_live_execution_gray": false,
    "max_parallel_workers_per_run": 16
  },
  "model_routing": {
    "goal_spec": "strong",
    "planning": "strong",
    "brainstorming": "strong",
    "architecture": "strong",
    "coding": "medium",
    "review": "strong",
    "debugging": "medium",
    "summarization": "cheap",
    "classification": "cheap",
    "evaluation": "medium"
  },
  "provider_route_strategy": {
    "strong_goal_spec": {
      "primary_model": "glm-5",
      "cost_saver_model": "glm-4.7",
      "min_calls_before_enforcement": 3,
      "min_success_rate_for_validation": 0.8,
      "max_timeout_failures_for_validation": 1,
      "provider_deadline_seconds": 120,
      "stream_idle_timeout_seconds": 30,
      "continue_primary_when": [
        "release gate is being refreshed",
        "route guidance is healthy",
        "recent success rate is at or above min_success_rate_for_validation"
      ],
      "allow_cost_saver_when": [
        "task is a small validation task",
        "cost budget is constrained",
        "cost_saver recent success rate is at or above min_success_rate_for_validation"
      ],
      "downgrade_or_retry_when": [
        "primary route is transiently rate limited",
        "primary route hits one timeout but recent success rate remains acceptable",
        "task is doc-only or low-risk and medium route is healthy"
      ],
      "block_validation_when": [
        "strong goal_spec success rate is below min_success_rate_for_validation after min_calls_before_enforcement calls",
        "timeout failures exceed max_timeout_failures_for_validation",
        "authentication, budget, or configuration failure is present",
        "provider streaming evidence is missing for required strong and medium routes"
      ]
    }
  },
  "commands": {
    "agent_invocable_without_approval": [
      "plan",
      "brainstorm",
      "compact",
      "review",
      "debug",
      "handoff"
    ],
    "user_invocation_required": [
      "init"
    ],
    "network_required": [
      "research"
    ]
  }
}
